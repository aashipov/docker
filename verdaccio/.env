# string interpolation in both .env & docker-compose.yml
VERDACCIO=verdaccio
COMPOSE_PROJECT_NAME=${VERDACCIO}

DUMMY_USER=dummy
DUMMY_UID=10001
DUMMY_GID=10001

VERDACCIO_IMAGE=verdaccio/verdaccio
VERDACCIO_PORT=8091
VERDACCIO_USER_UID=${DUMMY_UID}
VERDACCIO_PUBLIC_URL=http://${VERDACCIO}:${VERDACCIO_PORT}