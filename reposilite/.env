# string interpolation in both .env & docker-compose.yml
REPOSILITE=reposilite
NEXUS=nexus
COMPOSE_PROJECT_NAME=${REPOSILITE}

DUMMY_USER=dummy
DUMMY_UID=10001
DUMMY_GID=10001

REPOSILITE_WORK_DIR=/${DUMMY_USER}/reposilite/
REPOSILITE_XMX=128m
REPOSILITE_PORT=8088
REPOSILITE_TOKEN=admin:admin
