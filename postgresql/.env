# string interpolation in both .env & docker-compose.yml
POSTGRES=postgres
COMPOSE_PROJECT_NAME=${POSTGRES}
# glibc-backed is faster than musl-backed one
POSTGRES_IMAGE=${POSTGRES}:17-bookworm
DUMMY_UID=10001

# PostgreSQL settings
POSTGRES_DB=${POSTGRES}
POSTGRES_USER=${POSTGRES}
POSTGRES_PASSWORD=${POSTGRES}
PGUSER=${POSTGRES}
POSTGRES_HEALTHCHECK_CMD=pg_isready -d ${POSTGRES} -U ${POSTGRES}
